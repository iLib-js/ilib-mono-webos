{
    "name": "sample-webos-rs",
    "id": "sample-webos-rs",
    "projectType": "webos-rs",
    "sourceLocale": "en-KR",
    "pseudoLocale": {
        "zxx-XX": "debug",
        "zxx-Hebr-XX": "debug-rtl",
        "zxx-Cyrl-XX": "debug-cyrillic",
        "zxx-Hans-XX": "debug-han-simplified"
    },
    "resourceDirs": {
        "json":"resources"
    },
    "resourceFileTypes": {
        "json":"ilib-loctool-webos-json-resource"
    },
    "plugins": [
        "ilib-loctool-webos-rs"
    ],
    "excludes": [
        ".*",
        "test",
        "xliffs",
        "common",
        "resources"
    ],
    "settings": {
        "translationsDir": ["./xliffs", "./common"],
        "locales":[
            "en-US",
            "en-AU",
            "en-GB",
            "es-CO",
            "es-ES",
            "fr-CA",
            "fr-FR",
            "ko-KR",
            "ja-JP"
        ],
        "rs": {
            "mappings": {
                "**/*.rs": {
                    "template": "[resourceDir]/[localeDir]/rsstrings.json"
                }
            }
        }
    }
}
